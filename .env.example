# Copy to .env and adjust as needed

# Database — SQLite (default) or Postgres
DATABASE_URL=sqlite:////data/scraper.db
# DATABASE_URL=postgresql://scraper:scraper@localhost:5432/scraper

# Server
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Timezone
TZ=Europe/London

# Playwright browser path (set by Docker entrypoint)
# PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# GitHub Container Registry (for docker-compose.yml image tag)
# GITHUB_USERNAME=your-github-username

# Discord webhook for fleece/synchilla alerts
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN
